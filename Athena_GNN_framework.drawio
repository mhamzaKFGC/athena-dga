<mxfile host="app.diagrams.net">
  <diagram id="athena-gnn" name="Athena GNN framework">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Athena: character-level GNN domain generator and its evaluation against DGA classifiers" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ SECTION A: TRAINING ============ -->
        <mxCell id="secA" value="1. Training (learn what real domain names look like)" style="swimlane;horizontal=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1480" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="A1" value="Majestic top-200k&lt;br&gt;legit domain labels" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="130" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="A2" value="&lt;b&gt;Clean &amp;amp; split&lt;/b&gt;&lt;br&gt;valid DNS label, de-duplicate&lt;br&gt;train 80% / val 10% / test 10%&lt;br&gt;alphabet: a-z, 0-9, '-'&lt;br&gt;plus &amp;lt;start&amp;gt; and &amp;lt;stop&amp;gt; tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="190" height="120" as="geometry"/>
        </mxCell>

        <!-- character graph inset -->
        <mxCell id="A3box" value="Character graph (one per name)" style="swimlane;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="95" width="340" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="n0" value="&amp;lt;s&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="160" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="l" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="565" y="160" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="o" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="t" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="715" y="160" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ne1" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne2" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne3" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="A3note" value="Node = one character position (e.g. &quot;lot...&quot;)&lt;br&gt;Edge = message from the previous position to the current one&lt;br&gt;Node feature = learned embedding (width 128)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="230" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- GNN model -->
        <mxCell id="A4box" value="Graph neural network (CharacterGraph)" style="swimlane;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="95" width="320" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="G1" value="Embedding: 39 tokens → 128-dim node features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="130" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="G2" value="&lt;b&gt;Message-passing layer × 3&lt;/b&gt;&lt;br&gt;concat(own state, previous-position state) → Linear(256→128) → tanh&lt;br&gt;each layer widens the view by one earlier character" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="190" width="280" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="G3" value="Readout: Linear(128→39) = next-character logits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="275" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="Ge1" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="G1" target="G2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Ge2" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="G2" target="G3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="A5" value="&lt;b&gt;Train&lt;/b&gt;&lt;br&gt;loss: cross-entropy on next character&lt;br&gt;Adam, lr 0.003, 10 epochs, batch 256&lt;br&gt;keep lowest validation loss&lt;br&gt;test loss reported once&lt;br&gt;&lt;i&gt;athena_v1_weights.pt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="125" width="240" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="ea1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="A2" target="A3box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="A3box" target="A4box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="A4box" target="A5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ SECTION B: GENERATION ============ -->
        <mxCell id="secB" value="2. Generation (autoregressive sampling, one character at a time)" style="swimlane;horizontal=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="1480" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="B1" value="&lt;b&gt;Prefix&lt;/b&gt;&lt;br&gt;first 3 characters of a legit domain&lt;br&gt;e.g. &quot;tri&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="B2" value="&lt;b&gt;Context window&lt;/b&gt;&lt;br&gt;last 4 tokens (n_layers + 1)&lt;br&gt;&amp;lt;s&amp;gt; t r i" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="470" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="B3" value="&lt;b&gt;Trained GNN&lt;/b&gt;&lt;br&gt;scores for every possible next character" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="B4" value="&lt;b&gt;Constrain &amp;amp; sample&lt;/b&gt;&lt;br&gt;block &amp;lt;start&amp;gt;; no stop or '-' too early&lt;br&gt;keep top-k = 8 candidates&lt;br&gt;softmax with temperature 0.8&lt;br&gt;draw one character" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="460" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="B5" value="&lt;b&gt;Reject filters&lt;/b&gt;&lt;br&gt;≤ 12 characters, valid DNS label&lt;br&gt;not already in the 200k list&lt;br&gt;not 1 edit away from a known name&lt;br&gt;no duplicates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="460" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="B6" value="&lt;b&gt;Athena domain&lt;/b&gt;&lt;br&gt;name + TLD (cycled: .com .net .io .ai ...)&lt;br&gt;e.g. tribraryfood.online" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="470" width="190" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="eb1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb4" value="stop token or length limit" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="B4" target="B5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb5" value="passes" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="B5" target="B6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- loop back -->
        <mxCell id="loop" value="append the new character, repeat" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B4" target="B2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="615"/>
              <mxPoint x="350" y="615"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- rejected loop -->
        <mxCell id="rej" value="rejected: sample again" style="endArrow=classic;html=1;dashed=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B5" target="B1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1105" y="640"/>
              <mxPoint x="130" y="640"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- trained weights link -->
        <mxCell id="wlink" value="trained weights" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A5" target="B3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1340" y="385"/>
              <mxPoint x="575" y="385"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============ SECTION C: EVALUATION ============ -->
        <mxCell id="secC" value="3. Evaluation (can existing DGA detectors tell Athena names from real ones?)" style="swimlane;horizontal=1;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="1480" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="C1" value="&lt;b&gt;100 matched pairs&lt;/b&gt;&lt;br&gt;real held-out legit name&lt;br&gt;vs Athena name from its prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="760" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="C2" value="&lt;b&gt;7 DGA classifiers (no retraining)&lt;/b&gt;&lt;br&gt;n-CBDC · MaldomDetector · ATT-CNN-BiLSTM&lt;br&gt;NGram-KL-Jaccard · LA-LSTM-Attention&lt;br&gt;Integrated-DL · HDDN&lt;br&gt;trained on the full UMUDGA corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="750" width="290" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="C3" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;P(DGA) ≥ 0.5 ⇒ flagged&lt;br&gt;plus majority vote of 7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="745" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="C4" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;Athena flagged vs legit flagged (false positives)&lt;br&gt;evasion rate: 97 – 100%&lt;br&gt;mean and median scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="755" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="C5" value="&lt;b&gt;Explainability (XAI)&lt;/b&gt;&lt;br&gt;character Shapley, Integrated Gradients, attention&lt;br&gt;shows why: common n-grams (ing, ent, la, so) look legit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="755" width="270" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="ec1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="C1" target="C2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="C2" target="C3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="C3" target="C4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="C4" target="C5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- generation to evaluation -->
        <mxCell id="gen2eval" value="Athena names" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B6" target="C1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1365" y="682"/>
              <mxPoint x="150" y="682"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
