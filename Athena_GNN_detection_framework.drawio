<mxfile host="app.diagrams.net">
  <diagram id="gnn-detect" name="GNN DGA detection framework">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Proposed GNN framework for DGA detection on a domain–IP–host graph (to catch Athena-style names)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ ROW 1: DATA AND GRAPH ============ -->
        <mxCell id="secA" value="1. Data and graph construction" style="swimlane;horizontal=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1480" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="D1" value="Passive DNS /&lt;br&gt;resolver logs&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;host, domain, answer IP,&lt;br&gt;NXDOMAIN, TTL, time&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="D2" value="Labelled names&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UMUDGA (DGA), Majestic (legit),&lt;br&gt;Athena (evasive synthetic)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="170" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="Gbox" value="Heterogeneous graph (one time window)" style="swimlane;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="98" width="560" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="H1" value="Host A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="H2" value="Host B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="255" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="xjkqpwz.com" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="128" width="100" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="lotus.com" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="178" width="100" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="tribraryfood.online" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="228" width="100" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="hpljedsafe.net" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="278" width="100" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ip1" value="IP 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="175" width="70" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ip2" value="IP 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="255" width="70" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="nx" value="NXDOMAIN" style="text;html=1;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="133" width="80" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="q1" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="H1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="H1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q3" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="H1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q4" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="H2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q5" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="H2" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r1" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="d2" target="ip1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="d3" target="ip2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="d4" target="ip2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1" style="endArrow=none;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=2;curved=1;" edge="1" parent="1" source="d1" target="d4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="600" y="215"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="Legend" value="&lt;b&gt;Node types&lt;/b&gt;&lt;br&gt;Host (client), Domain, IP&lt;br&gt;&lt;br&gt;&lt;b&gt;Edge types&lt;/b&gt;&lt;br&gt;Host → Domain: queried (blue)&lt;br&gt;Domain → IP: resolved to (green)&lt;br&gt;Domain – Domain: similar n-grams / co-queried (purple dashed)&lt;br&gt;&lt;br&gt;&lt;b&gt;Labels&lt;/b&gt;&lt;br&gt;known DGA (red), known legit (yellow), unknown = to predict" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="98" width="290" height="225" as="geometry"/>
        </mxCell>

        <mxCell id="Feat" value="&lt;b&gt;Node features&lt;/b&gt;&lt;br&gt;&lt;b&gt;Domain:&lt;/b&gt; character CNN/BiLSTM embedding of the name; length, entropy, longest consonant run, NXDOMAIN rate, TTL, age&lt;br&gt;&lt;b&gt;Host:&lt;/b&gt; query volume, NXDOMAIN ratio, share of new domains&lt;br&gt;&lt;b&gt;IP:&lt;/b&gt; ASN, number of domains" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="98" width="270" height="225" as="geometry"/>
        </mxCell>

        <mxCell id="ea1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="D1" target="Gbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="D2" target="Gbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="Gbox" target="Legend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="Legend" target="Feat"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ ROW 2: GNN ============ -->
        <mxCell id="secB" value="2. Graph neural network (message passing, then node classification)" style="swimlane;horizontal=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="365" width="1480" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="X1" value="&lt;b&gt;Feature matrix X&lt;/b&gt;&lt;br&gt;one row per Host, Domain, IP node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="435" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;GNN layer 1&lt;/b&gt;&lt;br&gt;type-specific neighbour aggregation&lt;br&gt;(GraphSAGE or GAT)&lt;br&gt;h' = σ(W·[h_self, AGG(h_neighbours)])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="425" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;GNN layers 2–3&lt;/b&gt;&lt;br&gt;same block repeated&lt;br&gt;each layer sees one more hop&lt;br&gt;domain → IP → other domains&lt;br&gt;domain → host → other domains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="425" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="E1" value="&lt;b&gt;Domain embedding&lt;/b&gt;&lt;br&gt;h(d) mixes its own spelling with its neighbourhood behaviour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="435" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="HD" value="&lt;b&gt;Classifier head&lt;/b&gt;&lt;br&gt;MLP + sigmoid&lt;br&gt;P(DGA) per domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="435" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="OUT" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;DGA / legit verdict per domain&lt;br&gt;infected hosts = hosts querying many flagged domains&lt;br&gt;cluster flagged domains by family" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="425" width="210" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="eb1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="X1" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="L2" target="E1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="E1" target="HD"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb5" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="HD" target="OUT"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="callout" value="&lt;b&gt;Why a graph helps against Athena:&lt;/b&gt; Athena names look legitimate by spelling, so name-only classifiers miss them (97–100% evasion). A GNN also sees behaviour: NXDOMAIN bursts, hosts querying many never-seen names, and clusters of domains that share hosts or IPs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="560" width="740" height="55" as="geometry"/>
        </mxCell>

        <!-- ============ ROW 3: TRAINING AND EVALUATION ============ -->
        <mxCell id="secC" value="3. Training and evaluation" style="swimlane;horizontal=1;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="1480" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="T1" value="&lt;b&gt;Training&lt;/b&gt;&lt;br&gt;semi-supervised node classification&lt;br&gt;binary cross-entropy on labelled domain nodes&lt;br&gt;Adam; Athena names added as hard cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="725" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;Data splits&lt;/b&gt;&lt;br&gt;random split&lt;br&gt;unseen-family split (hold out whole DGA families, as in the zero-day test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="725" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;Baselines&lt;/b&gt;&lt;br&gt;the 7 name-only classifiers&lt;br&gt;(n-CBDC, HDDN, ...)&lt;br&gt;same test names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="725" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="T4" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;F1, ROC-AUC, false-positive rate&lt;br&gt;recall on unseen families&lt;br&gt;Athena evasion rate&lt;br&gt;(does it fall below 97–100%?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="925" y="725" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="T5" value="&lt;b&gt;Explainability&lt;/b&gt;&lt;br&gt;GNNExplainer / Shapley&lt;br&gt;which neighbours and edges drive each verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="725" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="ec1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="T1" target="T2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="T2" target="T3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="T3" target="T4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="T4" target="T5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- cross-row links -->
        <mxCell id="x1" value="build X" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Feat" target="X1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1335" y="352"/>
              <mxPoint x="135" y="352"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="x2" value="predictions" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="OUT" target="T1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1365" y="647"/>
              <mxPoint x="180" y="647"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
